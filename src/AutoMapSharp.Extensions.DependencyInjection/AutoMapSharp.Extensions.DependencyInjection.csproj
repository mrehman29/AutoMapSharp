<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0;net9.0</TargetFrameworks>
    <RootNamespace>AutoMapSharp.Extensions.DependencyInjection</RootNamespace>
    <IsPackable>true</IsPackable>
    <PackageId>AutoMapSharp.Extensions.DependencyInjection</PackageId>
    <Title>AutoMapSharp dependency injection</Title>
    <Description>Registers AutoMapSharp with Microsoft.Extensions.DependencyInjection in one line. AddAutoMapSharp scans your assemblies for mapping modules, resolvers, converters and mapping actions, and gives you an IMapEngine that can use scoped services. The equivalent of AddAutoMapper for teams moving from AutoMapper.</Description>
    <PackageTags>mapper;object-mapper;mapping;automapper;automapper-alternative;dependency-injection;aspnetcore</PackageTags>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <!-- XML docs give package users IntelliSense. Public members without comments are allowed for now. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AutoMapSharp\AutoMapSharp.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.0" />
  </ItemGroup>

</Project>
