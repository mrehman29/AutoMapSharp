@model AutoMapSharp.Sample.Web.Models.WebMultiItemOrderViewModel
@{
    ViewData["Title"] = "Phase 4.1: Standard Collection Mapping";
    var source = ViewBag.SourceOrder as AutoMapSharp.Sample.Web.Models.WebMultiItemOrder;
}

<div class="container py-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
            <li class="breadcrumb-item active" aria-current="page">Collections: Standard</li>
        </ol>
    </nav>

    <div class="card shadow-sm mb-4 border-0">
        <div class="card-header bg-primary text-white py-3">
            <h4 class="mb-0"><i class="bi bi-list-check me-2"></i>Task 4.1: Standard Collection Mapping (Arrays, Lists, Enumerables)</h4>
        </div>
        <div class="card-body">
            <p class="lead">
                AutoMapSharp maps collections (<code>List&lt;T&gt;</code>, <code>T[]</code>, <code>IEnumerable&lt;T&gt;</code>) with pre-sized allocations and automatic element-level sub-mapping.
            </p>

            <div class="row mt-4">
                <div class="col-md-12">
                    <div class="card border-primary">
                        <div class="card-header bg-light d-flex justify-content-between align-items-center">
                            <h5 class="mb-0 text-primary"><i class="bi bi-cart4 me-2"></i>Order #@Model.OrderId — @Model.CustomerName</h5>
                            <span class="badge bg-success fs-6">@Model.Items?.Count Mapped Line Items</span>
                        </div>
                        <div class="card-body">
                            <table class="table table-hover table-bordered mb-0">
                                <thead class="table-dark">
                                    <tr>
                                        <th>#</th>
                                        <th>Product Name</th>
                                        <th class="text-end">Unit Price</th>
                                        <th class="text-center">Quantity</th>
                                        <th class="text-end">Line Total</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model.Items != null)
                                    {
                                        decimal grandTotal = 0;
                                        @foreach (var item in Model.Items)
                                        {
                                            grandTotal += item.LineTotal;
                                            <tr>
                                                <td>@item.Id</td>
                                                <td><strong>@item.ProductName</strong></td>
                                                <td class="text-end">$@item.UnitPrice.ToString("N2")</td>
                                                <td class="text-center"><span class="badge bg-info text-dark">@item.Quantity</span></td>
                                                <td class="text-end fw-bold text-success">$@item.LineTotal.ToString("N2")</td>
                                            </tr>
                                        }
                                        <tr class="table-light">
                                            <td colspan="4" class="text-end fw-bold fs-5">Grand Total:</td>
                                            <td class="text-end fw-bold text-primary fs-5">$@grandTotal.ToString("N2")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <div class="mt-4">
                <a asp-action="DictionariesAndSets" class="btn btn-primary"><i class="bi bi-arrow-right me-1"></i>Next: Dictionaries & Sets</a>
            </div>
        </div>
    </div>
</div>
