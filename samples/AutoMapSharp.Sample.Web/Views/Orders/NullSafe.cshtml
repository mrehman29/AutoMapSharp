@using System.Text.Json
@model AutoMapSharp.Sample.Web.Models.ComparisonViewModel<AutoMapSharp.Sample.Web.Models.Order, AutoMapSharp.Sample.Web.Models.OrderSummaryViewModel>
@{
    ViewData["Title"] = Model.FeatureTitle;
    var jsonOptions = new JsonSerializerOptions { WriteIndented = true };
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="fw-bold text-dark">@Model.FeatureTitle</h2>
        <p class="text-muted">@Model.FeatureDescription</p>
    </div>
    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary btn-sm">&larr; Back to Dashboard</a>
</div>

<div class="alert alert-info d-flex align-items-center mb-4 shadow-sm" role="alert">
    <div class="me-3 fs-3">🛡️</div>
    <div>
        <h5 class="alert-heading fw-bold mb-1">Null-Safe Evaluation Guarantee</h5>
        <p class="mb-0">
            Source entity has <code>Customer = null</code>. Rather than crashing with <code>NullReferenceException</code>, AutoMapSharp automatically short-circuits the path and safely assigns <code>null</code>.
        </p>
    </div>
</div>

<div class="row g-4">
    <!-- Left Column: Source Entity -->
    <div class="col-lg-6">
        <div class="card h-100 shadow-sm border-0">
            <div class="card-header bg-secondary text-white fw-bold">
                1. Source Object (with Customer = null)
            </div>
            <div class="card-body">
                <ul class="list-group list-group-flush mb-3">
                    <li class="list-group-item d-flex justify-content-between">
                        <strong>Order Id:</strong> <span>@Model.Source.Id</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between">
                        <strong>Customer Navigation:</strong> <span class="badge bg-danger">null</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between">
                        <strong>Status:</strong> <span class="badge bg-primary">@Model.Source.Status</span>
                    </li>
                </ul>
                <h6 class="fw-semibold text-muted">Raw JSON:</h6>
                <pre class="json-box">@JsonSerializer.Serialize(Model.Source, jsonOptions)</pre>
            </div>
        </div>
    </div>

    <!-- Right Column: Mapped ViewModel -->
    <div class="col-lg-6">
        <div class="card h-100 shadow-sm border-info border-2">
            <div class="card-header bg-info text-dark fw-bold">
                2. AutoMapSharp Mapped Result (Zero Exceptions)
            </div>
            <div class="card-body">
                <ul class="list-group list-group-flush mb-3">
                    <li class="list-group-item d-flex justify-content-between">
                        <strong>Id:</strong> <span class="fw-bold">@Model.Destination.Id</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between">
                        <strong>CustomerName:</strong> <span class="badge bg-secondary">null</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between">
                        <strong>CustomerAddressCity:</strong> <span class="badge bg-secondary">null</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between">
                        <strong>Status:</strong> <span class="badge bg-primary">"@Model.Destination.Status"</span>
                    </li>
                </ul>
                <h6 class="fw-semibold text-muted">Result JSON:</h6>
                <pre class="json-box">@JsonSerializer.Serialize(Model.Destination, jsonOptions)</pre>
            </div>
        </div>
    </div>
</div>
