@model List<AutoMapSharp.Sample.Web.Models.AnalyzerRuleViewModel>
@{
    ViewData["Title"] = "Roslyn Analyzers & Diagnostics";
}

<div class="container py-4">
    <div class="row mb-4">
        <div class="col-12">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
                    <li class="breadcrumb-item active">Phase 7: Roslyn Analyzers</li>
                </ol>
            </nav>
            <h1 class="display-6 fw-bold text-primary">Compile-Time Roslyn Diagnostic Analyzers</h1>
            <p class="lead text-muted">
                Catch mapping bugs during compilation rather than at runtime. AutoMapSharp includes first-party analyzers that run inside Visual Studio, Rider, VS Code, and command-line CI builds.
            </p>
        </div>
    </div>

    <div class="row g-4">
        @foreach (var rule in Model)
        {
            <div class="col-12">
                <div class="card shadow-sm border-0">
                    <div class="card-header bg-white d-flex justify-content-between align-items-center py-3">
                        <div>
                            <span class="badge @(rule.Severity == "Error" ? "bg-danger" : "bg-warning text-dark") me-2">@rule.Severity</span>
                            <span class="badge bg-secondary me-2">@rule.Category</span>
                            <strong class="fs-5">@rule.Id: @rule.Title</strong>
                        </div>
                        <span class="text-muted small">DiagnosticAnalyzer</span>
                    </div>
                    <div class="card-body">
                        <p class="card-text">@rule.Description</p>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <h6 class="text-danger fw-semibold"><i class="bi bi-x-circle-fill me-1"></i> Triggers Warning / Error</h6>
                                <pre class="bg-light p-3 rounded border border-danger-subtle font-monospace small"><code>@rule.BadCodeExample</code></pre>
                            </div>
                            <div class="col-md-6">
                                <h6 class="text-success fw-semibold"><i class="bi bi-check-circle-fill me-1"></i> Recommended Resolution</h6>
                                <pre class="bg-light p-3 rounded border border-success-subtle font-monospace small"><code>@rule.FixedCodeExample</code></pre>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <div class="row mt-4">
        <div class="col-12">
            <div class="card bg-light border-0 shadow-sm">
                <div class="card-body p-4">
                    <h5 class="fw-bold">Enforcing Warnings as Errors in CI</h5>
                    <p class="text-muted mb-2">Configure your project or <code>Directory.Build.props</code> to stop builds when mapping issues are flagged:</p>
                    <pre class="bg-white p-3 rounded border font-monospace small"><code>&lt;PropertyGroup&gt;
  &lt;TreatWarningsAsErrors&gt;true&lt;/TreatWarningsAsErrors&gt;
  &lt;WarningsAsErrors&gt;$(WarningsAsErrors);AMS001;AMS002;AMS003&lt;/WarningsAsErrors&gt;
&lt;/PropertyGroup&gt;</code></pre>
                </div>
            </div>
        </div>
    </div>
</div>
