@using System.Text.Json
@model AutoMapSharp.Sample.Web.Models.ComparisonViewModel<AutoMapSharp.Sample.Web.Models.WebCustomerSource, AutoMapSharp.Sample.Web.Models.WebCustomerRecord>
@{
    ViewData["Title"] = Model.FeatureTitle;
    var jsonOptions = new JsonSerializerOptions { WriteIndented = true };
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="fw-bold text-dark">@Model.FeatureTitle</h2>
        <p class="text-muted">@Model.FeatureDescription</p>
    </div>
    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary btn-sm">&larr; Back to Dashboard</a>
</div>

<div class="card mb-4 shadow-sm border-0">
    <div class="card-header bg-dark text-white fw-semibold">
        C# 9+ Positional Record Definition & Mapping
    </div>
    <div class="card-body p-0">
        <pre class="code-snippet m-0"><code>// Record declaration (No parameterless constructor):
public record WebCustomerRecord(int Id, string FullName, string Tier);

// AutoMapSharp matches constructor parameter names automatically:
DefineMap&lt;WebCustomerSource, WebCustomerRecord&gt;();</code></pre>
    </div>
</div>

<div class="row g-4">
    <!-- Left Column: Source Class Instance -->
    <div class="col-lg-6">
        <div class="card h-100 shadow-sm border-0">
            <div class="card-header bg-secondary text-white fw-bold">
                1. Source Class Instance
            </div>
            <div class="card-body">
                <ul class="list-group list-group-flush mb-3">
                    <li class="list-group-item d-flex justify-content-between">
                        <strong>Id:</strong> <span>@Model.Source.Id</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between">
                        <strong>FullName:</strong> <span>@Model.Source.FullName</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between">
                        <strong>Tier:</strong> <span class="badge bg-primary">@Model.Source.Tier</span>
                    </li>
                </ul>
                <h6 class="fw-semibold text-muted">Raw JSON:</h6>
                <pre class="json-box">@JsonSerializer.Serialize(Model.Source, jsonOptions)</pre>
            </div>
        </div>
    </div>

    <!-- Right Column: Mapped Positional Record -->
    <div class="col-lg-6">
        <div class="card h-100 shadow-sm border-danger border-2">
            <div class="card-header bg-danger text-white fw-bold">
                2. Mapped Positional Record (Immutable)
            </div>
            <div class="card-body">
                <ul class="list-group list-group-flush mb-3">
                    <li class="list-group-item d-flex justify-content-between">
                        <strong>Id:</strong> <span class="fw-bold">@Model.Destination.Id</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between">
                        <strong>FullName:</strong> <span class="badge bg-success">@Model.Destination.FullName</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between">
                        <strong>Tier:</strong> <span class="badge bg-warning text-dark">@Model.Destination.Tier</span>
                    </li>
                </ul>
                <h6 class="fw-semibold text-muted">Record Result JSON:</h6>
                <pre class="json-box">@JsonSerializer.Serialize(Model.Destination, jsonOptions)</pre>
            </div>
        </div>
    </div>
</div>
