@model AutoMapSharp.Sample.Web.Models.PipelineViewModel
@{
    ViewData["Title"] = "CI/CD & Verification Pipeline";
}

<div class="container py-4">
    <div class="row mb-4">
        <div class="col-12">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
                    <li class="breadcrumb-item active">Phase 8: CI/CD Pipeline</li>
                </ol>
            </nav>
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h1 class="display-6 fw-bold text-primary">CI/CD & Packaging Architecture</h1>
                    <p class="lead text-muted mb-0">
                        Automated multi-OS continuous integration, local NuGet consumer verification, and release pipeline.
                    </p>
                </div>
                <div>
                    <span class="badge bg-primary py-2 px-3 fs-6">
                        <i class="bi bi-github me-1"></i> @Model.CiProvider
                    </span>
                </div>
            </div>
        </div>
    </div>

    <!-- Matrix Platforms -->
    <div class="row g-3 mb-4">
        @foreach (var platform in Model.Platforms)
        {
            <div class="col-md-4">
                <div class="card shadow-sm border-0">
                    <div class="card-body d-flex align-items-center">
                        <i class="bi bi-cpu fs-3 text-primary me-3"></i>
                        <div>
                            <span class="badge bg-secondary mb-1">Matrix Runner</span>
                            <h6 class="fw-bold mb-0">@platform</h6>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Verification Stages -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-white py-3">
            <h5 class="fw-bold mb-0">Continuous Verification Pipeline Stages</h5>
        </div>
        <div class="card-body p-0">
            <ul class="list-group list-group-flush">
                @foreach (var stage in Model.VerificationStages)
                {
                    <li class="list-group-item d-flex justify-content-between align-items-center py-3">
                        <span class="fw-semibold font-monospace small">
                            <i class="bi bi-check2-circle text-success me-2 fs-6"></i> @stage
                        </span>
                        <span class="badge bg-success">Automated / Verified</span>
                    </li>
                }
            </ul>
        </div>
    </div>

    <!-- Workflow File Info -->
    <div class="card bg-light border-0 shadow-sm">
        <div class="card-body p-4">
            <h5 class="fw-bold">Workflow Configuration File</h5>
            <p class="text-muted small mb-2">Automated on every push and pull request to <code>main</code>:</p>
            <pre class="bg-white p-3 rounded border font-monospace small"><code>@Model.WorkflowFile</code></pre>
        </div>
    </div>
</div>
