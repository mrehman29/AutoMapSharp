@model List<AutoMapSharp.Sample.Web.Models.WebPaymentViewModel>
@{
    ViewData["Title"] = "Phase 5.3: Polymorphic & Subclass Mapping";
}

<div class="container py-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
            <li class="breadcrumb-item active" aria-current="page">Polymorphic: Billing Transactions</li>
        </ol>
    </nav>

    <div class="card shadow-sm mb-4 border-0">
        <div class="card-header bg-primary text-white py-3">
            <h4 class="mb-0"><i class="bi bi-intersect me-2"></i>Task 5.3: Subclass & Polymorphic Mapping (Include & IncludeBase)</h4>
        </div>
        <div class="card-body">
            <p class="lead">
                AutoMapSharp evaluates the runtime concrete type of abstract base classes and interfaces, automatically dispatching to the registered derived DTO mapping.
            </p>

            <div class="row g-4 mt-2">
                @foreach (var payment in Model)
                {
                    <div class="col-md-4">
                        @if (payment is AutoMapSharp.Sample.Web.Models.WebCreditCardPaymentViewModel cc)
                        {
                            <div class="card h-100 border-primary shadow-sm">
                                <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                                    <h6 class="mb-0"><i class="bi bi-credit-card-2-front me-2"></i>@cc.PaymentType</h6>
                                    <span class="badge bg-light text-primary">@cc.CardNetwork</span>
                                </div>
                                <div class="card-body">
                                    <h4 class="card-title text-primary fw-bold">$@cc.Amount.ToString("N2") <small class="text-muted fs-6">@cc.Currency</small></h4>
                                    <p class="text-muted small">Txn: <code>@cc.TransactionId</code></p>
                                    <hr />
                                    <p class="mb-1"><strong>Cardholder:</strong> @cc.CardHolder</p>
                                    <p class="mb-1"><strong>Card Number:</strong> <code>@cc.MaskedCardNumber</code></p>
                                    <p class="mb-0 text-muted small"><i class="bi bi-clock me-1"></i>@cc.ProcessedAt.ToString("u")</p>
                                </div>
                            </div>
                        }
                        else if (payment is AutoMapSharp.Sample.Web.Models.WebCryptoPaymentViewModel crypto)
                        {
                            <div class="card h-100 border-warning shadow-sm">
                                <div class="card-header bg-warning text-dark d-flex justify-content-between align-items-center">
                                    <h6 class="mb-0"><i class="bi bi-currency-bitcoin me-2"></i>@crypto.PaymentType</h6>
                                    <span class="badge bg-dark">@crypto.BlockchainNetwork</span>
                                </div>
                                <div class="card-body">
                                    <h4 class="card-title text-dark fw-bold">@crypto.Amount.ToString("N2") <small class="text-muted fs-6">@crypto.Currency</small></h4>
                                    <p class="text-muted small">Txn: <code>@crypto.TransactionId</code></p>
                                    <hr />
                                    <p class="mb-1"><strong>Wallet:</strong> <code class="small">@crypto.WalletAddress</code></p>
                                    <p class="mb-1"><strong>Gas Fee:</strong> @crypto.GasFee ETH</p>
                                    <p class="mb-0 text-muted small"><i class="bi bi-clock me-1"></i>@crypto.ProcessedAt.ToString("u")</p>
                                </div>
                            </div>
                        }
                        else if (payment is AutoMapSharp.Sample.Web.Models.WebBankTransferPaymentViewModel bank)
                        {
                            <div class="card h-100 border-success shadow-sm">
                                <div class="card-header bg-success text-white d-flex justify-content-between align-items-center">
                                    <h6 class="mb-0"><i class="bi bi-bank me-2"></i>@bank.PaymentType</h6>
                                    <span class="badge bg-light text-success">Wire Transfer</span>
                                </div>
                                <div class="card-body">
                                    <h4 class="card-title text-success fw-bold">$@bank.Amount.ToString("N2") <small class="text-muted fs-6">@bank.Currency</small></h4>
                                    <p class="text-muted small">Txn: <code>@bank.TransactionId</code></p>
                                    <hr />
                                    <p class="mb-1"><strong>Bank:</strong> @bank.BankName</p>
                                    <p class="mb-1"><strong>Routing:</strong> <code>@bank.RoutingNumberMasked</code></p>
                                    <p class="mb-0 text-muted small"><i class="bi bi-clock me-1"></i>@bank.ProcessedAt.ToString("u")</p>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>

            <!-- Configuration Snippet -->
            <div class="mt-4">
                <h5 class="fw-bold"><i class="bi bi-code-slash me-2"></i>Polymorphic Dispatch Configuration</h5>
                <pre class="code-snippet"><code>DefineMap&lt;WebPayment, WebPaymentViewModel&gt;()
    .Include&lt;WebCreditCardPayment, WebCreditCardPaymentViewModel&gt;()
    .Include&lt;WebCryptoPayment, WebCryptoPaymentViewModel&gt;()
    .Include&lt;WebBankTransferPayment, WebBankTransferPaymentViewModel&gt;();

DefineMap&lt;WebCreditCardPayment, WebCreditCardPaymentViewModel&gt;()
    .IncludeBase&lt;WebPayment, WebPaymentViewModel&gt;();</code></pre>
            </div>

            <div class="d-flex justify-content-between mt-4">
                <a asp-controller="Resolvers" asp-action="TypeConverters" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Previous: Type Converters</a>
                <a asp-controller="Lifecycle" asp-action="Hooks" class="btn btn-primary"><i class="bi bi-arrow-right me-1"></i>Next: Lifecycle Hooks</a>
            </div>
        </div>
    </div>
</div>
