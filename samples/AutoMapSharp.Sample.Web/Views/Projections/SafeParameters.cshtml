@model AutoMapSharp.Sample.Web.Models.SafeParametersViewModel
@{
    ViewData["Title"] = "Safe Parameterized Projections";
}

<div class="container py-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
            <li class="breadcrumb-item">Reliability &amp; Parity</li>
            <li class="breadcrumb-item active" aria-current="page">Safe Parameterized Projections</li>
        </ol>
    </nav>

    <h1 class="display-6 fw-bold text-primary">Safe Parameterized Projections</h1>
    <p class="lead">
        A projection parameter is a local that the module captures in <code>MapSource</code>.
        Each <code>ProjectOnto</code> call passes its own value, and EF Core sends it as a SQL parameter.
    </p>

    <div class="alert alert-success">
        Fixed during the code review (findings F03 and F04). Before the fix, the first value was cached and reused by every later call,
        and an entity column with the same name as the parameter was replaced by the value, which removed the filter.
    </div>

    <form method="get" asp-action="SafeParameters" class="card bg-light p-3 mb-4 border">
        <div class="row align-items-center g-3">
            <div class="col-auto"><label class="form-label mb-0 fw-bold" for="minQuantity">Count order lines with quantity of at least</label></div>
            <div class="col-auto">
                <select id="minQuantity" name="minQuantity" class="form-select">
                    @foreach (var q in new[] { 1, 2, 3 })
                    {
                        <option value="@q" selected="@(q == Model.SelectedMinQuantity)">@q</option>
                    }
                </select>
            </div>
            <div class="col-auto"><button type="submit" class="btn btn-primary">Run query</button></div>
        </div>
    </form>

    <div class="row g-4 mb-4">
        @foreach (var (label, value, rows) in new[]
        {
            ("Your value", Model.SelectedMinQuantity, Model.SelectedResults),
            ("Same request, different value", Model.ComparisonMinQuantity, Model.ComparisonResults)
        })
        {
            <div class="col-lg-6">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-header bg-white fw-bold">@label: <code>minQuantity = @value</code></div>
                    <div class="card-body p-0">
                        <table class="table table-sm mb-0">
                            <thead class="table-light"><tr><th>Order</th><th class="text-end">Lines with quantity of at least @value</th></tr></thead>
                            <tbody>
                                @foreach (var row in rows)
                                {
                                    <tr><td>@row.OrderNumber</td><td class="text-end fw-bold">@row.BulkLineCount</td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
    </div>

    <div class="row g-4 mb-4">
        <div class="col-lg-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white fw-bold">Module code</div>
                <div class="card-body"><pre class="mb-0 small"><code>@Model.ModuleSnippet</code></pre></div>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white fw-bold">Query code</div>
                <div class="card-body"><pre class="mb-0 small"><code>@Model.QuerySnippet</code></pre></div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-white fw-bold">SQL generated by EF Core for your value</div>
        <div class="card-body"><pre class="mb-0 small" data-testid="generated-sql">@Model.GeneratedSql</pre></div>
        <div class="card-footer bg-white small text-muted">
            The value appears as a parameter, not inside the SQL text, so EF Core can reuse the query plan.
            The AutoMapper equivalent is <code>ProjectTo&lt;BulkOrderSummaryDto&gt;(config, new { minQuantity })</code>.
        </div>
    </div>

    <p class="text-muted small">Documentation: <code>docs/features/parameterized-projections.md</code></p>
</div>
