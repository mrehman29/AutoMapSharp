@model List<AutoMapSharp.Sample.Web.Models.OrderProjectionDto>
@{
    ViewData["Title"] = "Phase 6.1: Database Projections (ProjectOnto)";
    string generatedSql = ViewBag.GeneratedSql as string ?? string.Empty;
}

<div class="container py-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
            <li class="breadcrumb-item active" aria-current="page">Projections: ProjectOnto</li>
        </ol>
    </nav>

    <div class="card shadow-sm mb-4 border-0">
        <div class="card-header bg-primary text-white py-3">
            <h4 class="mb-0"><i class="bi bi-database-check me-2"></i>Task 6.1: Database Projections (ProjectOnto on IQueryable)</h4>
        </div>
        <div class="card-body">
            <p class="lead">
                <code>.ProjectOnto&lt;TDest&gt;(engine)</code> transforms an EF Core <code>IQueryable</code> directly into a minimal SQL <code>SELECT</code> projection, retrieving only mapped columns from the database.
            </p>

            <div class="card border-primary mb-4 shadow-sm">
                <div class="card-header bg-light d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 text-primary"><i class="bi bi-table me-2"></i>Projected Order DTOs (@Model.Count orders)</h5>
                    <span class="badge bg-success">SQLite In-Memory DB</span>
                </div>
                <div class="card-body p-0">
                    <table class="table table-hover table-striped mb-0">
                        <thead class="table-dark">
                            <tr>
                                <th>#</th>
                                <th>Order Number</th>
                                <th>Customer Name</th>
                                <th>Customer City</th>
                                <th>Tenant</th>
                                <th class="text-end">Total Amount</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var order in Model)
                            {
                                <tr>
                                    <td><code>#@order.Id</code></td>
                                    <td><strong>@order.OrderNumber</strong></td>
                                    <td>@order.CustomerName</td>
                                    <td><span class="badge bg-info text-dark">@order.CustomerAddressCity</span></td>
                                    <td><span class="badge bg-secondary">@order.TenantBadge</span></td>
                                    <td class="text-end fw-bold text-success">$@order.TotalAmount.ToString("N2")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Live Generated SQL -->
            <div class="card border-secondary shadow-sm mb-4">
                <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
                    <h6 class="mb-0"><i class="bi bi-terminal me-2"></i>Exact SQL Generated by Entity Framework Core</h6>
                    <span class="badge bg-light text-dark">SQLite Dialect</span>
                </div>
                <div class="card-body">
                    <pre class="code-snippet mb-0"><code>@generatedSql</code></pre>
                </div>
            </div>

            <!-- Configuration Snippet -->
            <div class="mt-4">
                <h5 class="fw-bold"><i class="bi bi-code-slash me-2"></i>C# Query Code</h5>
                <pre class="code-snippet"><code>// In Controller / Repository:
var orders = await dbContext.Orders
    .ProjectOnto&lt;OrderProjectionDto&gt;(mapEngine)
    .ToListAsync();</code></pre>
            </div>

            <div class="d-flex justify-content-between mt-4">
                <a asp-controller="Diagnostics" asp-action="HealthCheck" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Previous: Health Check</a>
                <a asp-action="SqlInspector" class="btn btn-primary"><i class="bi bi-arrow-right me-1"></i>Next: SQL Query Inspector</a>
            </div>
        </div>
    </div>
</div>
