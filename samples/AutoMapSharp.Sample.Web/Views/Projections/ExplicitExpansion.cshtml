@model List<AutoMapSharp.Sample.Web.Models.OrderProjectionDto>
@{
    ViewData["Title"] = "Phase 6.4: Explicit Expansion";
    bool expandItems = ViewBag.ExpandItems == true;
    bool expandAudit = ViewBag.ExpandAudit == true;
    string generatedSql = ViewBag.GeneratedSql as string ?? string.Empty;
}

<div class="container py-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
            <li class="breadcrumb-item active" aria-current="page">Projections: Explicit Expansion</li>
        </ol>
    </nav>

    <div class="card shadow-sm mb-4 border-0">
        <div class="card-header bg-primary text-white py-3">
            <h4 class="mb-0"><i class="bi bi-arrows-angle-expand me-2"></i>Task 6.4: Explicit Expansion for Navigation Properties</h4>
        </div>
        <div class="card-body">
            <p class="lead">
                <code>opt.ExplicitExpansion()</code> prevents eager projection of heavy relational navigation properties unless explicitly requested by the caller via <code>membersToExpand</code>.
            </p>

            <!-- Toggle Controls -->
            <form method="get" asp-action="ExplicitExpansion" class="card bg-light p-3 mb-4 border">
                <div class="row align-items-center g-3">
                    <div class="col-auto">
                        <strong>Expand Related Entities:</strong>
                    </div>
                    <div class="col-auto">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" name="expandItems" value="true" id="chkItems" @(expandItems ? "checked" : "") onchange="this.form.submit()">
                            <label class="form-check-label fw-semibold" for="chkItems">Order Items (1-to-N Collection)</label>
                        </div>
                    </div>
                    <div class="col-auto">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" name="expandAudit" value="true" id="chkAudit" @(expandAudit ? "checked" : "") onchange="this.form.submit()">
                            <label class="form-check-label fw-semibold" for="chkAudit">Audit Logs (History)</label>
                        </div>
                    </div>
                </div>
            </form>

            <!-- Results Cards with Expanded Data -->
            <div class="row g-4 mb-4">
                @foreach (var order in Model)
                {
                    <div class="col-md-6">
                        <div class="card border-primary h-100 shadow-sm">
                            <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                                <h6 class="mb-0">Order: @order.OrderNumber</h6>
                                <span class="badge bg-light text-primary">$@order.TotalAmount.ToString("N2")</span>
                            </div>
                            <div class="card-body">
                                <p class="mb-1"><strong>Customer:</strong> @order.CustomerName (@order.CustomerAddressCity)</p>
                                <hr />

                                <!-- Items Section -->
                                <h6>
                                    Items:
                                    @if (order.Items == null)
                                    {
                                        <span class="badge bg-secondary ms-1">Omitted (Not Expanded)</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success ms-1">@order.Items.Count Item(s) Expanded</span>
                                    }
                                </h6>
                                @if (order.Items != null)
                                {
                                    <ul class="list-group list-group-flush mb-3">
                                        @foreach (var item in order.Items)
                                        {
                                            <li class="list-group-item px-0 py-1 d-flex justify-content-between align-items-center small">
                                                <span>@item.ProductName (x@item.Quantity)</span>
                                                <span class="fw-bold">$@item.LineTotal.ToString("N2")</span>
                                            </li>
                                        }
                                    </ul>
                                }

                                <!-- Audit Logs Section -->
                                <h6>
                                    Audit Logs:
                                    @if (order.AuditLogs == null)
                                    {
                                        <span class="badge bg-secondary ms-1">Omitted (Not Expanded)</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-info text-dark ms-1">@order.AuditLogs.Count Log(s) Expanded</span>
                                    }
                                </h6>
                                @if (order.AuditLogs != null)
                                {
                                    <ul class="list-group list-group-flush">
                                        @foreach (var log in order.AuditLogs)
                                        {
                                            <li class="list-group-item px-0 py-1 small text-muted">
                                                <i class="bi bi-clock-history me-1"></i>@log
                                            </li>
                                        }
                                    </ul>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>

            <!-- Generated SQL Query -->
            <div class="card border-secondary shadow-sm mb-4">
                <div class="card-header bg-dark text-white">
                    <h6 class="mb-0"><i class="bi bi-terminal me-2"></i>Generated SQL (Notice inclusion/omission of child subqueries/JOINs)</h6>
                </div>
                <div class="card-body">
                    <pre class="code-snippet mb-0" style="max-height: 250px;"><code>@generatedSql</code></pre>
                </div>
            </div>

            <div class="d-flex justify-content-between mt-4">
                <a asp-action="Filtered" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Previous: Parameterized Projections</a>
                <a asp-controller="Home" asp-action="Index" class="btn btn-primary"><i class="bi bi-house me-1"></i>Home Dashboard</a>
            </div>
        </div>
    </div>
</div>
