@model List<AutoMapSharp.Sample.Web.Models.OrderProjectionDto>
@{
    ViewData["Title"] = "Phase 6.3: Parameterized Projections";
    decimal minTotal = ViewBag.MinTotal != null ? (decimal)ViewBag.MinTotal : 1500m;
    string generatedSql = ViewBag.GeneratedSql as string ?? string.Empty;
}

<div class="container py-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
            <li class="breadcrumb-item active" aria-current="page">Projections: Parameterized Query</li>
        </ol>
    </nav>

    <div class="card shadow-sm mb-4 border-0">
        <div class="card-header bg-primary text-white py-3">
            <h4 class="mb-0"><i class="bi bi-funnel me-2"></i>Task 6.3: Parameterized Projections</h4>
        </div>
        <div class="card-body">
            <p class="lead">
                Pass runtime parameters into <code>ProjectOnto(engine, new { minTotal })</code> to enable secure, SQL-parameterized queries with query plan caching.
            </p>

            <div class="alert alert-info small">
                On this page the minimum total is applied with <code>Where</code> before <code>ProjectOnto</code>.
                To use a parameter inside a <code>MapSource</code> expression, see
                <a asp-controller="Projections" asp-action="SafeParameters">Safe Parameterized Projections</a>.
            </div>

            <!-- Filter Controls -->
            <form method="get" asp-action="Filtered" class="card bg-light p-3 mb-4 border">
                <div class="row align-items-center g-3">
                    <div class="col-auto">
                        <label class="form-label mb-0 fw-bold">Filter Minimum Order Total:</label>
                    </div>
                    <div class="col-auto">
                        <div class="input-group">
                            <span class="input-group-text">$</span>
                            <input type="number" name="minTotal" step="100" class="form-control" value="@minTotal" style="width: 140px;" />
                        </div>
                    </div>
                    <div class="col-auto">
                        <button type="submit" class="btn btn-primary"><i class="bi bi-filter me-1"></i>Apply Filter</button>
                    </div>
                    <div class="col-auto">
                        <span class="badge bg-secondary">Matches: @Model.Count orders</span>
                    </div>
                </div>
            </form>

            <!-- Results Table -->
            <div class="card border-primary mb-4 shadow-sm">
                <div class="card-header bg-light">
                    <h5 class="mb-0 text-primary">Filtered Orders (&ge; $@minTotal.ToString("N2"))</h5>
                </div>
                <div class="card-body p-0">
                    <table class="table table-hover table-striped mb-0">
                        <thead class="table-dark">
                            <tr>
                                <th>#</th>
                                <th>Order Number</th>
                                <th>Customer Name</th>
                                <th>Customer City</th>
                                <th class="text-end">Total Amount</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Count == 0)
                            {
                                <tr>
                                    <td colspan="5" class="text-center py-4 text-muted">No orders match the minimum threshold of $@minTotal.ToString("N2").</td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var order in Model)
                                {
                                    <tr>
                                        <td><code>#@order.Id</code></td>
                                        <td><strong>@order.OrderNumber</strong></td>
                                        <td>@order.CustomerName</td>
                                        <td>@order.CustomerAddressCity</td>
                                        <td class="text-end fw-bold text-success">$@order.TotalAmount.ToString("N2")</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Generated Parameterized SQL -->
            <div class="card border-secondary shadow-sm mb-4">
                <div class="card-header bg-dark text-white">
                    <h6 class="mb-0"><i class="bi bi-terminal me-2"></i>Generated Parameterized SQL Query</h6>
                </div>
                <div class="card-body">
                    <pre class="code-snippet mb-0"><code>@generatedSql</code></pre>
                </div>
            </div>

            <div class="d-flex justify-content-between mt-4">
                <a asp-action="SqlInspector" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Previous: SQL Inspector</a>
                <a asp-action="ExplicitExpansion" class="btn btn-primary"><i class="bi bi-arrow-right me-1"></i>Next: Explicit Expansion</a>
            </div>
        </div>
    </div>
</div>
