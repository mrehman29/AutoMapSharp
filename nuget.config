<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    The libraries, tests and benchmarks restore from nuget.org only.
    The sample app and the NuGet consumer tests also use the locally packed packages in
    artifacts/packages. They have their own nuget.config, because that folder only exists after
    ./scripts/pack-and-test.sh has run, and a missing source fails every restore on a fresh clone.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
