# Copy this file to nuget-publish.env and put your real key there.
# nuget-publish.env is ignored by git, so the key never reaches the public repository.
#
# Create a key at https://www.nuget.org/account/apikeys with the Push scope
# and the glob patterns AutoMapSharp* and dotnet-automapsharp-migrate.
NUGET_API_KEY=replace-with-your-nuget-api-key
