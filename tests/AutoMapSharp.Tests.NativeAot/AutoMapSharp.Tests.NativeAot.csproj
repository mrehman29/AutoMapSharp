<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net8.0;net9.0</TargetFrameworks>
    <RootNamespace>AutoMapSharp.Tests.NativeAot</RootNamespace>
    <PublishAot>true</PublishAot>
    <IsPackable>false</IsPackable>
    <!-- The library still has reflection-based fallbacks, which the AOT compiler reports as trim warnings.
         This test proves that generated maps run correctly as a native binary, so those warnings are allowed here. -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\AutoMapSharp\AutoMapSharp.csproj" />
    <ProjectReference Include="..\..\src\AutoMapSharp.Generators\AutoMapSharp.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
